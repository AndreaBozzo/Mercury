# Mercury — environment variable reference
# Copy this to .env and fill in your values.
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------

# NATS JetStream broker.
# Local dev: nats://localhost:4222
# Docker Compose: nats://nats:4222
NATS_URL=nats://localhost:4222

# Nephtys stream management API.
# Used by scripts/provision_nephtys.py to register exchange connectors.
# Nephtys defaults to port 3002.
NEPHTYS_API_URL=http://localhost:3002/v1/streams

# Bearer token for Nephtys admin endpoints (stream registration, pipeline
# updates). Required when Nephtys is started with admin auth enabled.
# Sent as `Authorization: Bearer <token>` by scripts/provision_nephtys.py.
NEPHTYS_ADMIN_TOKEN=

# Market-data connector profile registered in Nephtys. The EU-oriented default
# uses Coinbase's public BTC-EUR ticker and needs no exchange credentials.
# Available profiles: coinbase_btc_eur, binance_btc_usdt (legacy/research only).
MERCURY_MARKET_DATA_PROFILE=coinbase_btc_eur

# ---------------------------------------------------------------------------
# Execution safety and exchange credentials
# ---------------------------------------------------------------------------

# Observation mode is the public-alpha default. It creates no exchange client,
# makes no private API calls, and submits no orders.
# Modes: observe, sandbox. `live` is recognized only to fail closed; real-order
# execution is disabled in the public alpha.
EXECUTION_MODE=observe

# Required only for sandbox. Use a CCXT exchange id (for example `kraken`
# or `coinbase`) after independently verifying that the exact legal entity and
# requested services are authorised for your jurisdiction.
EXECUTION_EXCHANGE_ID=
EXCHANGE_API_KEY=
EXCHANGE_SECRET=

# Some exchanges require an additional passphrase/password.
EXCHANGE_PASSWORD=

# Symbols whose balances, orders, and P&L are reconciled in sandbox.
EXECUTOR_RECONCILE_SYMBOLS=BTC/EUR
EXECUTOR_ACCOUNT_REFRESH_SECONDS=15

# Conservative public examples. These legacy variable names are quote-value
# limits, not guarantees that every configured symbol is USD-denominated.
MAX_EXPOSURE_DOLLARS=25
MAX_TRADE_NOTIONAL_DOLLARS=5

# ---------------------------------------------------------------------------
# Brain / stream processor tuning
# ---------------------------------------------------------------------------

# NATS subject the brain subscribes to.
# Matches the Nephtys stream topic registered in provision_nephtys.py.
BRAIN_SUBJECT=nephtys.stream.crypto.btc
BRAIN_HTTP_HOST=127.0.0.1
BRAIN_HTTP_PORT=9108
BRAIN_STRATEGY=moving_average

# Legacy Binance depth snapshot bootstrap. Used only when
# MERCURY_MARKET_DATA_PROFILE=binance_btc_usdt.
BINANCE_REST_URL=https://api.binance.com
BINANCE_DEPTH_LIMIT=1000
BINANCE_DEPTH_BOOTSTRAP_BUFFER=2000

# Bytewax stream processor (brain/stream_processor.py)
VWAP_WINDOW=50          # ticks in the rolling VWAP window
IMBALANCE_WINDOW=20     # ticks in the rolling order book imbalance window
SIGNAL_THRESHOLD=0.01   # fractional VWAP divergence required to emit a signal (1%)

# ---------------------------------------------------------------------------
# Executor — sandbox position sizing
# ---------------------------------------------------------------------------
# Fraction of free quote cash (BUY) or free base inventory (SELL) considered at
# full conviction and full vol-modulator. The EUR notional cap still applies.
SIZING_FIXED_FRACTION=0.25

# Hard cap on per-trade notional in EUR. If this is below a sandbox venue's
# minimum, the order is skipped; Mercury never raises the cap automatically.
MAX_NOTIONAL_EUR=5

# Max age (seconds) for the available_balance KV entry before the sizer
# rejects the trade as `balance_stale`.
SIZING_BALANCE_MAX_AGE_SECONDS=60

# Max age (seconds) for the vol_modulator KV entry before the sizer
# rejects the trade as `vol_modulator_stale`.
VOL_MODULATOR_MAX_AGE_SECONDS=60

# Fail closed when the vol_modulator KV key is missing. Mercury does not yet
# ship its publisher, so sandbox execution remains blocked until the
# operator deliberately supplies this state or that component is implemented.
SIZING_REQUIRE_VOL_MODULATOR=true

# ---------------------------------------------------------------------------
# Plutarch — market-data archiver
# ---------------------------------------------------------------------------
# Lance dataset location (host path or container mount). Plutarch creates it
# if missing. In Docker, /data is mounted via the plutarch-data volume.
PLUTARCH_DATA_DIR=data/history
PLUTARCH_DATASET_NAME=market_history.lance

# Quarantine directory for batches that fail to write to Lance. Each failure
# produces one NDJSON file. External alerting is not implemented yet.
PLUTARCH_QUARANTINE_DIR=data/quarantine

# Flush trigger: whichever fires first.
PLUTARCH_BATCH_SIZE=500
PLUTARCH_FLUSH_INTERVAL_SEC=30

# JetStream must allow enough time for a normal buffered flush before
# redelivery. Ack-pending headroom must be at least one full batch.
PLUTARCH_ACK_WAIT_SEC=120
PLUTARCH_CONSUMER_MAX_DELIVER=10
PLUTARCH_CONSUMER_MAX_ACK_PENDING=1000

# JetStream consumer + stream config. Defaults match brain/main.py so the
# stream is reused. Override only for multi-tenant setups.
PLUTARCH_STREAM_NAME=nephtys_crypto
PLUTARCH_STREAM_SUBJECT=nephtys.stream.crypto.*
PLUTARCH_DURABLE_NAME=plutarch_archiver

# Observability endpoint (GET /healthz, GET /metrics).
PLUTARCH_HTTP_HOST=127.0.0.1
PLUTARCH_HTTP_PORT=9110
