# Mercury — environment variable reference
# Copy this to .env and fill in your values.
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------

# NATS JetStream broker.
# Local dev: nats://localhost:4222
# Docker Compose: nats://nats:4222
NATS_URL=nats://localhost:4222

# Nephtys stream management API.
# Used by scripts/provision_nephtys.py to register exchange connectors.
# Nephtys defaults to port 3002.
NEPHTYS_API_URL=http://localhost:3002/v1/streams

# Bearer token for Nephtys admin endpoints (stream registration, pipeline
# updates). Required when Nephtys is started with admin auth enabled.
# Sent as `Authorization: Bearer <token>` by scripts/provision_nephtys.py.
NEPHTYS_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Exchange credentials (executor service)
# ---------------------------------------------------------------------------

# Binance — always start with testnet keys.
# Testnet: https://testnet.binance.vision/
# Live: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Brain / stream processor tuning
# ---------------------------------------------------------------------------

# NATS subject the brain subscribes to.
# Matches the Nephtys stream topic registered in provision_nephtys.py.
BRAIN_SUBJECT=nephtys.stream.crypto.btc
BRAIN_HTTP_HOST=127.0.0.1
BRAIN_HTTP_PORT=9108

# Binance depth snapshot bootstrap for L2 order books.
BINANCE_REST_URL=https://api.binance.com
BINANCE_DEPTH_LIMIT=1000
BINANCE_DEPTH_BOOTSTRAP_BUFFER=2000

# Bytewax stream processor (brain/stream_processor.py)
VWAP_WINDOW=50          # ticks in the rolling VWAP window
IMBALANCE_WINDOW=20     # ticks in the rolling order book imbalance window
SIGNAL_THRESHOLD=0.01   # fractional VWAP divergence required to emit a signal (1%)

# ---------------------------------------------------------------------------
# Executor — position sizing (M1)
# ---------------------------------------------------------------------------
# DRY_RUN keeps the executor in paper mode (no exchange calls, sizer bypassed).
# Set to false ONLY when you are ready to hit Binance testnet/live.
DRY_RUN=true

# Fraction of free quote balance the sizer will deploy at full conviction
# (confidence=1.0) and full vol-modulator (multiplier=1.0). Final order
# notional = balance * SIZING_FIXED_FRACTION * confidence * vol_multiplier.
SIZING_FIXED_FRACTION=0.25

# Hard cap on per-trade notional in EUR. The default 5.5 sits just above
# Binance spot min-notional (~4.6 EUR). With a 9 EUR live deposit this
# allows ~1 trade in flight at a time. Lower it to test the skip path,
# raise it only as the deposit grows.
MAX_NOTIONAL_EUR=5.5

# Quote asset the sizer reads from `available_balance` KV. Override to
# USDT for Binance testnet (which usually does not credit EUR).
SIZING_BALANCE_ASSET=EUR

# Max age (seconds) for the available_balance KV entry before the sizer
# rejects the trade as `balance_stale`.
SIZING_BALANCE_MAX_AGE_SECONDS=60

# Max age (seconds) for the vol_modulator KV entry before the sizer
# rejects the trade as `vol_modulator_stale`.
VOL_MODULATOR_MAX_AGE_SECONDS=60

# When true, the sizer rejects trades if the vol_modulator KV key is
# completely missing. Default false during Week 1 (modulator not built yet);
# flip to true at the end of Week 2 once `run_modulator` is publishing.
SIZING_REQUIRE_VOL_MODULATOR=false

# Static EUR-per-quote FX used to convert MAX_NOTIONAL_EUR into the symbol's
# quote asset when the quote is not EUR (e.g. USDT). 1 USDT ≈ 0.92 EUR.
RISK_EUR_PER_QUOTE=0.92
