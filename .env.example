# Mercury — environment variable reference
# Copy this to .env and fill in your values.
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------

# NATS JetStream broker.
# Local dev: nats://localhost:4222
# Docker Compose: nats://nats:4222
NATS_URL=nats://localhost:4222

# Nephtys stream management API.
# Used by scripts/provision_nephtys.py to register exchange connectors.
# Nephtys defaults to port 3002.
NEPHTYS_API_URL=http://localhost:3002/v1/streams

# Optional bearer token for Nephtys admin endpoints. Required when
# NEPHTYS_ADMIN_TOKEN is set on the Nephtys side.
NEPHTYS_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Exchange credentials (executor service)
# ---------------------------------------------------------------------------

# Binance — always start with testnet keys.
# Testnet: https://testnet.binance.vision/
# Live: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Brain / stream processor tuning
# ---------------------------------------------------------------------------

# NATS subject the brain subscribes to.
# Matches the Nephtys stream topic registered in provision_nephtys.py.
BRAIN_SUBJECT=nephtys.stream.crypto.btc
BRAIN_HTTP_HOST=127.0.0.1
BRAIN_HTTP_PORT=9108

# Binance depth snapshot bootstrap for L2 order books.
BINANCE_REST_URL=https://api.binance.com
BINANCE_DEPTH_LIMIT=1000
BINANCE_DEPTH_BOOTSTRAP_BUFFER=2000

# Bytewax stream processor (brain/stream_processor.py)
VWAP_WINDOW=50          # ticks in the rolling VWAP window
IMBALANCE_WINDOW=20     # ticks in the rolling order book imbalance window
SIGNAL_THRESHOLD=0.01   # fractional VWAP divergence required to emit a signal (1%)
